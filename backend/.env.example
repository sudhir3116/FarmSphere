PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=<your_jwt_secret_key>
JWT_EXPIRE=7d
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>.apps.googleusercontent.com
CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>

# ==============================================================================
# SMS & Mobile OTP Provider Configuration
# FarmSphere supports Twilio Programmable Messaging, Fast2SMS, and MSG91.
# Switch active provider via SMS_PROVIDER ('twilio', 'fast2sms', 'msg91').
# ==============================================================================
SMS_PROVIDER=twilio
OTP_SECRET=<your_custom_otp_hmac_secret_salt>

# ------------------------------------------------------------------------------
# Primary Option: Twilio Programmable Messaging (Global SMS & Notifications)
# ------------------------------------------------------------------------------
# Required Twilio Credentials (from Twilio Console: https://console.twilio.com)
TWILIO_ACCOUNT_SID=<your_twilio_account_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
# Twilio sender number in E.164 format (e.g. +12055550100) or approved alphanumeric/DLT sender ID
TWILIO_FROM_NUMBER=<your_twilio_e164_phone_number>
# Optional: Twilio Messaging Service SID (alternative to TWILIO_FROM_NUMBER)
# TWILIO_MESSAGING_SERVICE_SID=<your_twilio_messaging_service_sid>

# Twilio Delivery Status Callback Webhook
# Register at: Twilio Console -> Phone Numbers -> Active Numbers -> Configure -> Messaging Status Callback URL
# URL: https://yourdomain.com/api/webhooks/twilio (HTTP POST)
# Handset delivery is tracked via webhook callbacks with X-Twilio-Signature validation.
TWILIO_STATUS_CALLBACK_URL=https://yourdomain.com/api/webhooks/twilio

# ------------------------------------------------------------------------------
# INDIA TELECOM (TRAI) & TWILIO REGULATORY NOTICE:
# To deliver A2P SMS to Indian mobile numbers (+91) via Twilio:
# 1. Complete Principal Entity (PE) registration on an Indian telecom DLT portal
#    (e.g., Vilpower, Jio DLT, Airtel DLT, PingConnect).
# 2. Register your Header/Sender ID (e.g., FARMSP) and Content Templates.
# 3. Submit your Principal Entity ID (PE ID) and Template IDs to Twilio via a
#    Twilio India DLT regulatory bundle or support request before live sending.
# 4. Standard international numbers without DLT approval are blocked by Indian telcos.
# 5. During development, set SMS_TEST_MODE=true to simulate delivery safely.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Secondary Option: MSG91 OTP Widget (For India OTP Verification)
# ------------------------------------------------------------------------------
# How to obtain these credentials:
# 1. Log in to your MSG91 control panel at https://control.msg91.com (or https://msg91.com)
# 2. In the left navigation, select "OTP" -> "Widget"
# 3. Click "Create Widget" or select an existing OTP Widget.
#    - Configure OTP length (6 digits recommended) and expiry.
#    - Set SMS as primary delivery route with your approved DLT Sender ID & Template.
# 4. Copy your Widget ID into MSG91_WIDGET_ID.
# 5. Under MSG91 Dashboard -> "Authkey", generate or copy your account Auth Key into MSG91_AUTH_KEY.
# 6. (Optional) If using widget token authentication instead of account authkey, set MSG91_TOKEN_AUTH.
MSG91_WIDGET_ID=<your_msg91_otp_widget_id>
MSG91_AUTH_KEY=<your_msg91_auth_key>
MSG91_TOKEN_AUTH=<optional_msg91_widget_token_auth>
MSG91_SENDER_ID=FARMSP

# ------------------------------------------------------------------------------
# Fallback Option: Twilio (Global SMS)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=<your_twilio_account_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_FROM_PHONE=<your_twilio_e164_phone_number>

# ------------------------------------------------------------------------------
# Fallback Option: Fast2SMS (India)
# Official API: POST https://www.fast2sms.com/dev/bulkV2
# Auth header:  authorization: YOUR_API_KEY
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=<your_fast2sms_api_key>

# SMS_ROUTE — controls the Fast2SMS API route parameter. Valid values:
#
#   q          — Quick SMS (free-text, no DLT template required).
#                Use ONLY for development and testing. Not TRAI-compliant for production.
#                Blocked automatically when NODE_ENV=production.
#                No additional env vars needed beyond FAST2SMS_API_KEY.
#
#   dlt        — Production DLT via Fast2SMS panel.
#                The 'message' field must contain the numeric DLT Template ID from your
#                Fast2SMS DLT Manager (not the message text). Variables go in FAST2SMS_VARIABLES_VALUES.
#                Required: SMS_SENDER_ID, FAST2SMS_TEMPLATE_ID
#                Optional: FAST2SMS_VARIABLES_VALUES (pipe-separated, e.g. "Rahul|8888|6695")
#
#   dlt_manual — Production DLT with raw template text sent directly to the operator.
#                Required: SMS_SENDER_ID, FAST2SMS_TEMPLATE_ID, FAST2SMS_ENTITY_ID
#
# NOTE: 'v3' is NOT a valid Fast2SMS route and will be rejected by the API.
SMS_ROUTE=q

# DLT configuration (required only for SMS_ROUTE=dlt or SMS_ROUTE=dlt_manual)
# Register at: https://www.fast2sms.com (DLT Manager section) after completing
# Principal Entity registration at your telecom operator's DLT portal.
SMS_SENDER_ID=<your_dlt_approved_sender_id>
FAST2SMS_TEMPLATE_ID=<your_dlt_template_id_numeric>
FAST2SMS_ENTITY_ID=<your_dlt_principal_entity_id>
FAST2SMS_VARIABLES_VALUES=<pipe_separated_variable_values_if_any>

# Fast2SMS Delivery Receipt Webhook (v2)
# Configured at: https://www.fast2sms.com/dev/webhook/v2/sms
# URL to register: https://yourdomain.com/api/webhooks/fast2sms
# Enable "Webhook Signing" in your Fast2SMS Dev API dashboard to get this secret.
FAST2SMS_WEBHOOK_SECRET=<your_40_char_fast2sms_webhook_secret>

# EMI Reminder Scheduler Settings (Zero-dependency Node.js background runner)
# REMINDER_INTERVAL_HOURS=24
# DISABLE_SCHEDULER=false


# ------------------------------------------------------------------------------
# Development-Only OTP Testing Mode (Free Testing Without SMS Provider)
# ------------------------------------------------------------------------------
# Enable to test mobile login and verification without paying for an SMS provider.
# SECURITY ENFORCEMENT:
# - Active ONLY when NODE_ENV=development AND OTP_DEV_MODE=true.
# - In production (NODE_ENV=production), this mode is HARD-BLOCKED and will
#   always reject requests if no real SMS provider is configured.
# - Generated OTPs are logged ONLY in the backend terminal/console; never in API responses.
# - Default test OTP is 123456 (or customize via OTP_DEV_CODE).
# - Full security rules (expiry in 10 mins, 5 attempt limit, 60s cooldown) apply.
OTP_DEV_MODE=false
OTP_DEV_CODE=123456

# ------------------------------------------------------------------------------
# Designated Test Numbers (Optional)
# Designated test numbers bypass external SMS gateways in development
# ------------------------------------------------------------------------------
SMS_TEST_MODE=false
SMS_AUTHORIZED_TEST_NUMBERS=+919876543210,+919876543211,+919123456789,+919999999999,+919800000000

